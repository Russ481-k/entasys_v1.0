generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  password       String          @default("$2b$08$Y5DIAN4lvVIpjGjaFPd.nup8F/dQxbyOuWEprW9/p9LWmInveT6Fe")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  name           String?
  email          String          @unique
  accountStatus  AccountStatus   @default(NOT_VERIFIED)
  image          String?
  authorizations UserRole[]
  language       String          @default("en")
  lastLoginAt    DateTime?
  searchSessions SearchSession[]
  createdBy      String?
  createdIp      String?
  updatedBy      String?
  updatedIp      String?
  verificationTokens VerificationToken[]
}

model VerificationToken {
  userId        String
  token         String   @unique
  expires       DateTime
  lastAttemptAt DateTime @updatedAt
  attempts      Int      @default(0)
  user          User     @relation(fields: [userId], references: [id])
}

model Repository {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String   @unique
  link        String
  description String?
}

model Project {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String   @unique
  description String?
}

model Menu {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  columns     MenuColumn[]
}

model Column {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  menus       MenuColumn[]
}

model MenuColumn {
  id       Int    @id @default(autoincrement())
  menuId   Int
  columnId Int
  column   Column @relation(fields: [columnId], references: [id])
  menu     Menu   @relation(fields: [menuId], references: [id])

  @@unique([menuId, columnId])
}

model SystemLicense {
  id            String    @id @default(cuid())
  hardwareHash  String    @unique
  activatedAt   DateTime  @default(now())
  expiresAt     DateTime
  lastCheckedAt DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SearchSession {
  id             String              @id @default(cuid())
  userId         String
  clientIp       String
  userAgent      String
  searchId       String              @unique
  status         SearchSessionStatus
  searchParams   Json
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lastActivityAt DateTime            @default(now())
  cancelReason   String?
  user           User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clientIp])
  @@index([status])
  @@index([searchId])
}

model Domain {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
}

enum AccountStatus {
  ENABLED
  DISABLED
  NOT_VERIFIED
}

enum UserRole {
  ADMIN
  SYSTEM_ADMIN
}

enum SearchSessionStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  ERROR
}
